msgctxt "Addon Summary"
msgid "Sega - Saturn (Yabause)"
msgstr ""

msgctxt "Addon Description"
msgid ""
"Yabause stands for Yet Another Buggy And Uncomplete Saturn Emulator. Yabause"
" can boot Sega Saturn bios and games, some of which are playable."
msgstr ""

msgctxt "Addon Disclaimer"
msgid "Icon credit: Anarkhya (anarkhya.deviantart.com)"
msgstr ""

msgctxt "#30001"
msgid "Frameskip"
msgstr "Pulo de quadro"

msgctxt "#30002"
msgid "Force HLE BIOS (Restart Required)"
msgstr "Impor a BIOS HLE (requer reinício)"

msgctxt "#30003"
msgid "Add-on Cartridge (Restart Required)"
msgstr "Cartucho de expansão (requer reinício)"

msgctxt "#30004"
msgid "6Player Adaptor on Port 1"
msgstr "Adaptador para seis jogadores na porta 1"

msgctxt "#30005"
msgid "6Player Adaptor on Port 2"
msgstr "Adaptador para seis jogadores na porta 2"

msgctxt "#30006"
msgid "Number of Threads (Restart Required)"
msgstr "Número de threads (requer reinício)"

msgctxt "#30007"
msgid "Skip frames to improve performance."
msgstr "Ignora quadros para melhorar o desempenho."

msgctxt "#30008"
msgid ""
"Use High Level Emulation BIOS. Not recommended, as it's causing more issues "
"than it solves."
msgstr ""
"Usa o BIOS de emulação de alto nível. Não é recomendado, pois causa mais "
"problemas do que resolve."

msgctxt "#30009"
msgid ""
"Emulate an add-on RAM expansion cartridge. Some games require this to be "
"played, while a few others will have improved performance."
msgstr ""
"Emula um cartucho de expansão de memória RAM. Alguns jogos precisam do "
"cartucho para ser jogados, enquanto alguns terão melhor desempenho."

msgctxt "#30010"
msgid "disabled"
msgstr ""

msgctxt "#30011"
msgid "1MB RAM"
msgstr "RAM de 1 MB"

msgctxt "#30012"
msgid "4MB RAM"
msgstr "RAM de 4 MB"

msgctxt "#30013"
msgid "Enable multitap in port 1."
msgstr "Ativa o multitap na porta 1."

msgctxt "#30014"
msgid "Enable multitap in port 2."
msgstr "Ativa o multitap na porta 2."

msgctxt "#30015"
msgid "Depending on your CPU, changing this value can improve performance."
msgstr "Dependendo da sua CPU, alterar o valor pode melhorar o desempenho."

#~ msgctxt "#30000"
#~ msgid "Settings"
#~ msgstr "Configurações"
