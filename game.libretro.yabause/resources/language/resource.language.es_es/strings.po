msgctxt "Addon Summary"
msgid "Sega - Saturn (Yabause)"
msgstr "Sega - Saturn (Yabause)"

msgctxt "Addon Description"
msgid "Yabause stands for Yet Another Buggy And Uncomplete Saturn Emulator. Yabause can boot Sega Saturn bios and games, some of which are playable."
msgstr "[CR]Yabause son las siglas de Yet Another Buggy And Uncomplete Saturn Emulator. [CR]Yabause puede arrancar bios y juegos de Sega Saturn, algunos de los cuales [CR]son jugables."

msgctxt "Addon Disclaimer"
msgid "Icon credit: Anarkhya (anarkhya.deviantart.com)"
msgstr "Crédito del icono: Anarkhya (anarkhya.deviantart.com)[CR][CR]Yabause son las siglas de Yet Another Buggy And Uncomplete Saturn Emulator. [CR]Yabause puede arrancar bios y juegos de Sega Saturn, algunos de los cuales [CR]son jugables."

"Yabause son las siglas de Yet Another Buggy And Uncomplete Saturn Emulator. "
"Yabause puede arrancar bios y juegos de Sega Saturn, algunos de los cuales "
"son jugables."


msgctxt "#30001"
msgid "Frameskip"
msgstr "Omisión de fotogramas"

msgctxt "#30002"
msgid "Force HLE BIOS (Restart Required)"
msgstr "Forzar BIOS HLE (es necesario reiniciar)"

msgctxt "#30003"
msgid "Add-on Cartridge (Restart Required)"
msgstr "Cartucho de expansión (es necesario reiniciar)"

msgctxt "#30004"
msgid "6Player Adaptor on Port 1"
msgstr "Adaptador para seis jugadores en el puerto 1"

msgctxt "#30005"
msgid "6Player Adaptor on Port 2"
msgstr "Adaptador para seis jugadores en el puerto 2"

msgctxt "#30006"
msgid "Number of Threads (Restart Required)"
msgstr "Número de hilos (es necesario reiniciar)"

msgctxt "#30007"
msgid "Skip frames to improve performance."
msgstr "Omite fotogramas para mejorar el rendimiento."

msgctxt "#30008"
msgid ""
"Use High Level Emulation BIOS. Not recommended, as it's causing more issues "
"than it solves."
msgstr ""
"Utiliza una BIOS emulada a alto nivel. No se recomienda su uso, ya que "
"produce más problemas de los que resuelve."

msgctxt "#30009"
msgid ""
"Emulate an add-on RAM expansion cartridge. Some games require this to be "
"played, while a few others will have improved performance."
msgstr ""
"Emula un cartucho de expansión de RAM. Algunos juegos necesitan uno de estos"
" cartuchos para poder funcionar, mientras que algunos otros verán una mejora"
" en su rendimiento."

msgctxt "#30010"
msgid "disabled"
msgstr "desactivado"

msgctxt "#30011"
msgid "1MB RAM"
msgstr "RAM de 1 MB"

msgctxt "#30012"
msgid "4MB RAM"
msgstr "RAM de 4 MB"

msgctxt "#30013"
msgid "Enable multitap in port 1."
msgstr "Activa un multitap conectado en el puerto 1."

msgctxt "#30014"
msgid "Enable multitap in port 2."
msgstr "Activa un multitap conectado en el puerto 2."

msgctxt "#30015"
msgid "Depending on your CPU, changing this value can improve performance."
msgstr "Este valor puede mejorar el rendimiento en función de tu CPU."

#~ msgctxt "#30000"
#~ msgid "Settings"
#~ msgstr "Ajustes"
