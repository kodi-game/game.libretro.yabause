msgctxt "Addon Summary"
msgid "Sega - Saturn (Yabause)"
msgstr "Sega — Saturn (Yabause)"

msgctxt "Addon Description"
msgid "Yabause stands for Yet Another Buggy And Uncomplete Saturn Emulator. Yabause can boot Sega Saturn bios and games, some of which are playable."
msgstr "[CR]Yabause расшифровывается как Yet Another Buggy And Uncomplete Saturn [CR]Emulator (Очередной глючный и незавершённый эмулятор Saturn). Yabause может [CR]загружать BIOS и игры Sega Saturn, некоторые из которых играбельны."

msgctxt "Addon Disclaimer"
msgid "Icon credit: Anarkhya (anarkhya.deviantart.com)"
msgstr "Автор значка: Anarkhya (anarkhya.deviantart.com)[CR][CR]Yabause расшифровывается как Yet Another Buggy And Uncomplete Saturn [CR]Emulator (Очередной глючный и незавершённый эмулятор Saturn). Yabause может [CR]загружать BIOS и игры Sega Saturn, некоторые из которых играбельны."

"Yabause расшифровывается как Yet Another Buggy And Uncomplete Saturn "
"Emulator (Очередной глючный и незавершённый эмулятор Saturn). Yabause может "
"загружать BIOS и игры Sega Saturn, некоторые из которых играбельны."


msgctxt "#30001"
msgid "Frameskip"
msgstr "Пропуск кадров"

msgctxt "#30002"
msgid "Force HLE BIOS (Restart Required)"
msgstr "Использовать HLE BIOS (требуется перезапуск)"

msgctxt "#30003"
msgid "Add-on Cartridge (Restart Required)"
msgstr "Картридж расширения (требуется перезапуск)"

msgctxt "#30004"
msgid "6Player Adaptor on Port 1"
msgstr "Адаптер для 6 игроков в порте 1"

msgctxt "#30005"
msgid "6Player Adaptor on Port 2"
msgstr "Адаптер для 6 игроков в порте 2"

msgctxt "#30006"
msgid "Number of Threads (Restart Required)"
msgstr "Число потоков (требуется перезапуск)"

msgctxt "#30007"
msgid "Skip frames to improve performance."
msgstr "Пропускать кадры для повышения производительности."

msgctxt "#30008"
msgid ""
"Use High Level Emulation BIOS. Not recommended, as it's causing more issues "
"than it solves."
msgstr ""
"Использовать высокоуровневую эмуляцию BIOS. Не рекомендуется, т.к. вызывает "
"больше проблем, чем даёт преимуществ."

msgctxt "#30009"
msgid ""
"Emulate an add-on RAM expansion cartridge. Some games require this to be "
"played, while a few others will have improved performance."
msgstr ""
"Эмуляция картриджа расширения ОЗУ. Повышает производительность или требуется"
" для запуска некоторых игр."

msgctxt "#30010"
msgid "disabled"
msgstr ""

msgctxt "#30011"
msgid "1MB RAM"
msgstr "1МБ ОЗУ"

msgctxt "#30012"
msgid "4MB RAM"
msgstr "4МБ ОЗУ"

msgctxt "#30013"
msgid "Enable multitap in port 1."
msgstr "Подключает Multitap для порта 1."

msgctxt "#30014"
msgid "Enable multitap in port 2."
msgstr "Подключает Multitap для порта 2."

msgctxt "#30015"
msgid "Depending on your CPU, changing this value can improve performance."
msgstr ""
"В зависимости от процессора вашего устройства, изменение настройки может "
"улучшить производительность."

#~ msgctxt "#30000"
#~ msgid "Settings"
#~ msgstr "Настройки"
