msgctxt "Addon Summary"
msgid "Sega - Saturn (Yabause)"
msgstr "Sega - Saturn (Yabause)"

msgctxt "Addon Description"
msgid "Yabause stands for Yet Another Buggy And Uncomplete Saturn Emulator. Yabause can boot Sega Saturn bios and games, some of which are playable."
msgstr "Yabause sta per Yet Another Buggy And Uncomplete Saturn Emulator. Yabause può avviare il bios e i giochi di Sega Saturn, alcuni dei quali sono giocabili."

msgctxt "Addon Disclaimer"
msgid "Icon credit: Anarkhya (anarkhya.deviantart.com)"
msgstr "Credito icona: Anarkhya (anarkhya.deviantart.com)"

msgctxt "#30001"
msgid "Frameskip"
msgstr "Salta fotogramma"

msgctxt "#30002"
msgid "Force HLE BIOS (Restart Required)"
msgstr "Forza HLE BIOS (Riavvio Richiesto)"

msgctxt "#30003"
msgid "Add-on Cartridge (Restart Required)"
msgstr "Cartuccia Componente (Riavvio Richiesto)"

msgctxt "#30004"
msgid "6Player Adaptor on Port 1"
msgstr "Adattatore 6Player sulla porta 1"

msgctxt "#30005"
msgid "6Player Adaptor on Port 2"
msgstr "Adattatore 6Player sulla porta 2"

msgctxt "#30006"
msgid "Number of Threads (Restart Required)"
msgstr "Numero di thread (Riavvio Richiesto)"

msgctxt "#30007"
msgid "Skip frames to improve performance."
msgstr "Salta fotogrammi per migliorare le prestazioni."

msgctxt "#30008"
msgid "Use High Level Emulation BIOS. Not recommended, as it's causing more issues than it solves."
msgstr "Usa BIOS ad emulazione ad alto livello. Non consigliato, perché sta causando più problemi di quanto risolva."

msgctxt "#30009"
msgid "Emulate an add-on RAM expansion cartridge. Some games require this to be played, while a few others will have improved performance."
msgstr "Emula una cartuccia di espansione RAM aggiuntiva. Alcuni giochi richiedono che questo sia riprodotto, mentre alcuni altri avranno prestazioni migliorate."

msgctxt "#30010"
msgid "disabled"
msgstr "disabilitato"

msgctxt "#30011"
msgid "1MB RAM"
msgstr "1MB RAM"

msgctxt "#30012"
msgid "4MB RAM"
msgstr "4MB RAM"

msgctxt "#30013"
msgid "Enable multitap in port 1."
msgstr "Abilita multitap nella porta 1."

msgctxt "#30014"
msgid "Enable multitap in port 2."
msgstr "Abilita multitap nella porta 2."

msgctxt "#30015"
msgid "Depending on your CPU, changing this value can improve performance."
msgstr "A seconda della CPU, cambiare questo valore può migliorare le prestazioni."

#~ msgctxt "#30000"
#~ msgid "Settings"
#~ msgstr "Impostazioni"
